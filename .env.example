# --- Render / env ---
MASTER_API_KEY=change-me-to-a-long-random-string
DATA_DIR=./data

# --- GitHub Gist persistence (RECOMMENDED on Render free tier) ---
# 1. Generate a token with `gist` scope at:
#    https://github.com/settings/tokens/new?scopes=gist
# 2. Paste the token here.
# 3. Leave GIST_ID empty on first run.
# 4. Start the service, then call POST /sync/init — it returns a gist_id.
# 5. Paste that gist_id into GIST_ID below (and on Render env vars), then restart.
GITHUB_GIST_TOKEN=
GIST_ID=

# --- Local dev only (Render auto-injects $PORT) ---
PORT=8000

# --- Telegram (only needed if you want a default api_id/api_hash) ---
# Get yours from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
